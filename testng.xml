<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Suite" parallel="classes" thread-count="2">

    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="Positive Tests">
        <classes>
            <class name="com.saucedemo.tests.PositiveLoginTests"/>
            <class name="com.saucedemo.tests.ProductTests"/>
            <class name="com.saucedemo.tests.CartTests"/>
            <class name="com.saucedemo.tests.CheckoutTests"/>
            <class name="com.saucedemo.tests.LogoutTests"/>
        </classes>
    </test>

    <test name="Negative Tests">
        <classes>
            <class name="com.saucedemo.tests.NegativeLoginTests"/>
            <class name="com.saucedemo.tests.NegativeCheckoutTests"/>
            <class name="com.saucedemo.tests.SessionTests"/>
            <class name="com.saucedemo.tests.NegativeCartTests"/>
        </classes>
    </test>

    <test name="End To End Tests">
        <classes>
            <class name="com.saucedemo.tests.EndToEndTests"/>
        </classes>
    </test>

</suite>
